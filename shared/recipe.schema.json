{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "recipe.schema.json",
  "title": "Recipe",
  "type": "object",
  "required": ["id", "title", "description", "category", "tags", "yield", "timing", "ingredients", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "kebab-case slug"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source": { "type": "string" },
    "yield": {
      "type": "object",
      "required": ["amount", "unit"],
      "additionalProperties": false,
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "timing": {
      "type": "object",
      "required": ["prep", "cook", "total"],
      "additionalProperties": false,
      "properties": {
        "prep": { "type": "string", "pattern": "^PT?" },
        "cook": { "type": "string", "pattern": "^PT?" },
        "total": { "type": "string", "pattern": "^PT?" },
        "rest": { "type": "string", "pattern": "^PT?" }
      }
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["items"],
        "additionalProperties": false,
        "properties": {
          "heading": { "type": "string" },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["quantity", "unit", "item", "scalable"],
              "additionalProperties": false,
              "properties": {
                "quantity": { "type": ["number", "null"] },
                "unit": { "type": ["string", "null"] },
                "item": { "type": "string", "minLength": 1 },
                "notes": { "type": "string" },
                "scalable": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["steps"],
        "additionalProperties": false,
        "properties": {
          "heading": { "type": "string" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["instruction"],
              "additionalProperties": false,
              "properties": {
                "instruction": { "type": "string", "minLength": 1 },
                "duration": { "type": "string", "pattern": "^PT?" },
                "temperature": {
                  "type": "object",
                  "required": ["value", "unit"],
                  "additionalProperties": false,
                  "properties": {
                    "value": { "type": "number" },
                    "unit": { "type": "string", "enum": ["F", "C"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
