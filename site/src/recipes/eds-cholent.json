  "steps": [
    {
      "heading": "Preparation",
      "steps": [
        {
          "instruction": "Add 2 cups water and place liner (will prevent scorching) in crock pot."
        },
        {
          "instruction": "Combine water, salt, pepper, garlic and onion and add to 6 quart crock pot."
        },
        {
          "instruction": "Place beef first, then rice and finally potatoes. Sprinkle with garlic powder and pepper. Cover."
        }
      ]
    },
    {
      "heading": "Cooking Instructions",
      "steps": [
        {
          "instruction": "Turn crock pot on high for three hours or until bubbling occurs, then turn down to medium.",
          "duration": "PT3H"
        },
        {
          "instruction": "Cholent will be ready to eat 24 hours later.",
          "duration": "PT24H"
        },
        {
          "instruction": "Add water to brim just before Shabbos."
        }
      ]
    },
    {
      "heading": "Or",
      "steps": [
        {
          "instruction": "Use regular pot, cover and cook for 2 to 3 hours. You will have to watch pot and turn down flame to avoid scorching.",
          "duration": "PT3H"
        }
      ]
    }
  ],
