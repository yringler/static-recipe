  "steps": [
    {
      "heading": "Preparation",
      "steps": [
        {
          "instruction": "Boil noodles and drain. It's always better to first boil the water, remove from the heat, add the noodles, stir, and cover. This will prevent scorched noodles."
        },
        {
          "instruction": "Melt margarine in sauce pan."
        },
        {
          "instruction": "Mix all ingredients together in large container."
        },
        {
          "instruction": "Distribute evenly in 7 to 10 greased pans."
        },
        {
          "instruction": "Mix topping ingredients together and spread evenly over noodles."
        },
        {
          "instruction": "Spray surface with cooking spray and cover with aluminum foil."
        }
      ]
    },
    {
      "heading": "Cooking Instructions",
      "steps": [
        {
          "instruction": "Place in oven and bake at 350 to 375 degrees F for about 1 hour.",
          "duration": "PT1H",
          "temperature": {
            "value": 350,
            "unit": "F"
          }
        },
        {
          "instruction": "Remove aluminum foil and continue baking until firm to the touch and golden brown. This will only take 5 to 10 minutes at most. Be careful not to burn.",
          "duration": "PT5M"
        }
      ]
    }
  ],
  "notes": [
    "Can bake between 350-375°F",
    "Final browning step takes 5-10 minutes - watch carefully to prevent burning"
