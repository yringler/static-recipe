---
pagination:
  data: recipes
  size: 1
  alias: recipe
permalink: "/recipes/{{ recipe.id }}/"
layout: base.njk
eleventyComputed:
  title: "{{ recipe.title }}"
---
<article class="recipe">
  <header class="recipe-header">
    <h1 class="recipe-title">{{ recipe.title }}</h1>
    <p class="recipe-description">{{ recipe.description }}</p>

    <div class="recipe-meta">
      <span class="category-badge">{{ recipe.category }}</span>
      {% if recipe.tags and recipe.tags.length %}
      <ul class="tag-list" aria-label="Tags">
        {% for tag in recipe.tags %}
        <li><a href="/tags/{{ tag }}/" class="tag-pill">{{ tag }}</a></li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>

    {% if recipe.source %}
    <p class="recipe-source">Source: <em>{{ recipe.source }}</em></p>
    {% endif %}
  </header>

  <section class="recipe-overview" aria-label="Overview">
    <dl class="timing-list">
      <div class="timing-item">
        <dt>Prep</dt>
        <dd>{{ recipe.timing.prep | formatDuration }}</dd>
      </div>
      <div class="timing-item">
        <dt>Cook</dt>
        <dd>{{ recipe.timing.cook | formatDuration }}</dd>
      </div>
      {% if recipe.timing.rest %}
      <div class="timing-item">
        <dt>Rest</dt>
        <dd>{{ recipe.timing.rest | formatDuration }}</dd>
      </div>
      {% endif %}
      <div class="timing-item timing-total">
        <dt>Total</dt>
        <dd>{{ recipe.timing.total | formatDuration }}</dd>
      </div>
    </dl>

    <div class="yield-row">
      <label for="yield-input" class="yield-label">
        Yield:
        <input
          type="number"
          id="yield-input"
          class="yield-input"
          value="{{ recipe.yield.amount }}"
          data-base-yield="{{ recipe.yield.amount }}"
          min="0.5"
          step="0.5"
        >
        <span class="yield-unit">{{ recipe.yield.unit }}</span>
      </label>
    </div>
  </section>

  <div class="recipe-body">
    <section class="recipe-ingredients" aria-label="Ingredients">
      <h2>Ingredients</h2>
      {% for group in recipe.ingredients %}
      <div class="ingredient-group">
        {% if group.heading %}
        <h3 class="group-heading">{{ group.heading }}</h3>
        {% endif %}
        <ul class="ingredient-list">
          {% for ingredient in group.items %}
          <li class="ingredient-item">
            {% if ingredient.scalable and ingredient.quantity !== null %}
            <span class="ingredient-qty" data-base-qty="{{ ingredient.quantity }}">{{ ingredient.quantity }}</span>
            {% elif ingredient.quantity !== null %}
            <span class="ingredient-qty">{{ ingredient.quantity }}</span>
            {% endif %}
            {% if ingredient.unit %}
            <span class="ingredient-unit">{{ ingredient.unit }}</span>
            {% endif %}
            <span class="ingredient-name">{{ ingredient.item }}</span>
            {% if ingredient.notes %}
            <span class="ingredient-notes">, {{ ingredient.notes }}</span>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </section>

    <section class="recipe-steps" aria-label="Instructions">
      <h2>Instructions</h2>
      {% for group in recipe.steps %}
      <div class="step-group">
        {% if group.heading %}
        <h3 class="group-heading">{{ group.heading }}</h3>
        {% endif %}
        <ol class="step-list">
          {% for step in group.steps %}
          <li class="step-item">
            <p class="step-instruction">{{ step.instruction }}</p>
            <div class="step-badges">
              {% if step.duration %}
              <span class="step-badge badge-duration">⏱ {{ step.duration | formatDuration }}</span>
              {% endif %}
              {% if step.temperature %}
              <span class="step-badge badge-temp">🌡 {{ step.temperature | formatTemp }}</span>
              {% endif %}
            </div>
          </li>
          {% endfor %}
        </ol>
      </div>
      {% endfor %}
    </section>
  </div>

  {% if recipe.notes and recipe.notes.length %}
  <section class="recipe-notes" aria-label="Notes">
    <h2>Notes</h2>
    <ul class="notes-list">
      {% for note in recipe.notes %}
      <li>{{ note }}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}
</article>

<script src="/js/scaler.js"></script>
